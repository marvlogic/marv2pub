}

module func_ex {
    ; what about functions that define resources?

    ; fine, but if multiple calls then must use 'with-context', 
    ; otherwise from a resource perspective they would redefine 
    ; a resource. Generally this is a 'parameterize' call.

    fn myfunc(n) = {
        with-context(n, { 
            ; ctx = [ $n, myfunc, loop_ex ]
            b := bucket(name=n)
            -> [
        })

        ; btw if called from another module, eg. module 'kev':
        ;   ctx = [$n, myfunc, loop_ex, kev]
    }
    myfunc("mybucket")

    ; NB we may consider allowing a with-global-context to
    ; completely override the current context, to be used
    ; carefully!

}


