    #       (:= sn2 (:: aws (compose1 subnet add-labels add-vpc) (hash 'zone zone) ))
    #
    #       ;(:== "_" (svar (list (hash-ref (sn1) 'snid) (hash-ref (sn2) 'snid))))
    #       (lambda()(cons (hash-ref (sn1) 'snid) (hash-ref (sn2) 'snid)))
    #       ;(list (hash-ref (sn1) 'snid) (hash-ref (sn2) 'snid))
