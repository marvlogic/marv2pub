#lang racket

(require
  json
  casemate
  )

(define (load-json path)
  (call-with-input-file path
    (lambda (in)
      (read-json in))))

(define (decode-html s)
  (regexp-replace* #px"<[^>]+>" s ""))

(define (make-attr-doc name spec required?)
  (define kebab-name (->kebab-case name))
  (define doc (hash-ref spec 'documentation ""))
  (define type (->kebab-case (hash-ref spec 'shape "unknown")))
  (string-append
   (format "@defthing[#:kind \"attribute\" ~a ~a]{" kebab-name type)
   (format "@secref{~a} @bold{Required:} ~a\n\n~a}"
           type
           (if required? "yes" "no")
           (decode-html doc))))

(define (generate-shape-doc name spec)
  (define members (hash-ref spec 'members (hash)))
  (define kebab-name (->kebab-case name))
  (append
   (list (format "@title[#:tag \"~a\"]{~a} @author{Generated by Racket}\n" kebab-name kebab-name))
   (list (format "@defthing[~a ~a]" kebab-name 'shape))
   (for/list ([(mname mspec) (in-hash members)])
     (make-attr-doc mname mspec (hash-ref mspec 'required #f)))))

(define (generate-list-doc name spec)
  (define shape (hash-ref (hash-ref spec 'member (hash)) 'shape))
  (define kebab-name (->kebab-case name))
  (append
   (list (format "@title[#:tag \"~a\"]{~a} @author{Generated by Racket}\n" kebab-name kebab-name))
   (list (format "@defthing[~a ~a]\n" kebab-name (->kebab-case shape)))))

(define (write-doc file-path content)
  (call-with-output-file file-path
    (lambda (out)
      (parameterize ([current-output-port out])
        (displayln "#lang scribble/manual")
        (displayln "@(require (for-label racket))")
        ;(displayln "@defmodule[aws-ec2]")
        (for-each displayln content)))
    #:exists 'replace))

(define (main)
  (define data (load-json "service2.json"))
  (define shapes (hash-ref data 'shapes (hash)))
  (define out-dir "shape-docs")
  (unless (directory-exists? out-dir)
    (make-directory out-dir))
  (hash-for-each
   shapes
   (lambda (name spec)
     (define fname (build-path out-dir (format "~a.scrbl" (->kebab-case name))))
     (case (hash-ref spec 'type "")
       [("structure")
        (define doc (generate-shape-doc name spec))
        (write-doc fname doc)]
       [("list")
        (define doc (generate-list-doc name spec))
        (write-doc fname doc)]
       ))))

(main)
